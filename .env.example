# ── Qdrant ────────────────────────────────────────────────────────────────────
# Option 1 : local embarqué, sans Docker (dev solo)
QDRANT_PATH=./qdrant_data

# Option 2 : serveur local Docker
# QDRANT_URL=http://localhost:6333

# Option 3 : Qdrant Cloud (prod)
# QDRANT_URL=https://xxx.europe-west3-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=your-api-key

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite local (dev)
DATABASE_URL=sqlite:///./xasida.db

# PostgreSQL (prod)
# DATABASE_URL=postgresql://user:password@host:5432/xasida
